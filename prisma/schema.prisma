// RESERVED, NOT BUILT — Test Batch and Opportunity Pipeline
//
// Both were explicitly scoped as "reserve the architecture, don't build
// it yet." No tables exist for either — an unused table nothing
// references is dead schema surface, which is its own kind of debt. The
// shapes below are the reserved design, ready to become real migrations
// when a later phase actually needs them:
//
// model TestBatch {
//   id                String   @id @default(cuid())
//   productId         String
//   purchaseId        String?
//   testQuantity      Int
//   testBudget        Decimal? @db.Decimal(12, 4)
//   successCriteria   String?
//   stopCriteria      String?
//   scaleCriteria     String?
//   status            String   // e.g. PLANNED / RUNNING / SUCCEEDED / STOPPED
// }
//
// enum OpportunityStage {
//   FOUND
//   CHECKING
//   PROFITABLE
//   ELIGIBILITY_CHECK
//   SUPPLIER_NEEDED
//   BRAND_CONTACT_NEEDED
