// --------------------------------------------------------------------------

// ============================================================================
// REAL DATA: AMAZON SALES IMPORT (CSV/Excel) — no SP-API in this phase
//
// Design settled across three review rounds with the Owner before this was
// applied. Key decisions, stated here so the reasoning travels with the
// schema rather than living only in chat history:
//
//   - unitSellingPrice and lineItemSubtotal are BOTH nullable on SaleItem.
//     Kawkab must never invent a unit price to create a "valid" row — if a
//     source report gives a line subtotal but no explicit unit price, the
//     subtotal is preserved as the source truth and nothing is fabricated
//     to fill the other field.
//   - Amazon financial activity (fees, refunds, credits, reimbursements) is
//     event-based (SaleFinancialEvent), never collapsed into fixed columns.
//     One SaleItem can have many financial events, arriving in the same
//     import or a later, independent one.
//   - SaleFinancialEvent.saleId is nullable — a finance report can arrive
//     before the sales report that would let it resolve to a Sale header.
//     Nothing is discarded while waiting for that reconciliation.
//   - Duplicate protection does NOT assume (eventType + externalEventId) is
//     globally unique — that hasn't been proven against real report data.
//   - source distinguishes FILE_IMPORT (this phase) from a future SP_API
//     sync (not built) without any of these models needing to change shape
//     when that phase arrives.
// ============================================================================

enum ImportReportType {
  SALES
  FINANCE
  INVENTORY
}

enum ImportBatchStatus {
  PENDING
  PROCESSING
  PROCESSED
  PARTIALLY_PROCESSED
  FAILED
}

enum ImportedRowStatus {
  PENDING
  MATCHED
  UNMATCHED
  DUPLICATE
  ERROR
  COMMITTED
}

model ImportBatch {
  id                String            @id @default(cuid())
  reportType        ImportReportType
  status            ImportBatchStatus @default(PENDING)
  filename          String
  originalRowCount  Int?
  matchedRowCount   Int?
  unmatchedRowCount Int?
  errorRowCount     Int?
  duplicateRowCount Int?
  notes             String?
  source            TransactionSource @default(FILE_IMPORT)
  createdByUserId   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  importedRows    ImportedRow[]
  sales           Sale[]
  financialEvents SaleFinancialEvent[]

  @@map("import_batches")
}

// reportType is denormalized from importBatch.reportType at creation time
// specifically so the uniqueness constraint below can be scoped by it —
// Prisma cannot compound a unique constraint across a joined table's field.
// Without this, a SALES row and a FINANCE row could collide on the same
// sourceRowKey even though they come from entirely different Amazon report
// formats with no guarantee of a shared ID namespace.
model ImportedRow {
  id               String            @id @default(cuid())
  importBatchId    String
  reportType       ImportReportType
  rowNumber        Int?
  rawData          Json
  status           ImportedRowStatus @default(PENDING)
  matchedProductId String?
  sourceRowKey     String?
  errorMessage     String?
  createdAt        DateTime          @default(now())

  importBatch     ImportBatch          @relation(fields: [importBatchId], references: [id])
  matchedProduct  Product?             @relation(fields: [matchedProductId], references: [id])
  saleItem        SaleItem?
  financialEvents SaleFinancialEvent[]

  @@unique([reportType, sourceRowKey])
  @@index([importBatchId])
  @@map("imported_rows")
}

model Sale {
  id              String            @id @default(cuid())
  saleDate        DateTime
  marketplaceId   String?
  importBatchId   String?
  externalOrderId String?           @unique
  source          TransactionSource @default(FILE_IMPORT)
  notes           String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  marketplace     Marketplace?         @relation(fields: [marketplaceId], references: [id])
  importBatch     ImportBatch?         @relation(fields: [importBatchId], references: [id])
  items           SaleItem[]
  financialEvents SaleFinancialEvent[]

  @@index([importBatchId])
  @@map("sales")
}

// unitSellingPrice and lineItemSubtotal are both nullable — see the module
// note above. Application-level validation (lib/sales.ts) should require
// at least one of them to be present before a row can be COMMITTED, but
// that is deliberately an application rule, not a database CHECK
// constraint — the two-nullable-columns shape is what lets "subtotal known,
// unit price not" be represented at all, and a DB-level "at least one"
// constraint would add real complexity for a rule that's easy to enforce
// correctly in the one code path that creates these rows.
model SaleItem {
  id                 String   @id @default(cuid())
  saleId             String
  productId          String
  quantity           Int
  unitSellingPrice   Decimal? @db.Decimal(12, 4)
  lineItemSubtotal   Decimal? @db.Decimal(12, 4)
  externalLineItemId String?  @unique
  importedRowId      String?  @unique
  notes              String?
  createdAt          DateTime @default(now())

  sale             Sale                 @relation(fields: [saleId], references: [id])
  product          Product              @relation(fields: [productId], references: [id])
  importedRow      ImportedRow?         @relation(fields: [importedRowId], references: [id])
  consumptionEvent ConsumptionEvent?
  financialEvents  SaleFinancialEvent[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum FinancialEventType {
  PRODUCT_REVENUE
  REFERRAL_FEE
  FBA_FULFILLMENT_FEE
  OTHER_FEE
  REFUND
  REFUND_FEE_CREDIT
  REIMBURSEMENT
  PROMOTION
  TAX
  ADJUSTMENT
  OTHER
}

// saleId is nullable — a finance report can arrive before the sales report
// that would let this resolve to a real Sale header. importFingerprint is
// the real, database-enforced duplicate guard: constructed by the import
// service (lib/financialEvents.ts) from whatever stable identifiers a
// given report row actually provides, NOT hardcoded as
// (eventType + externalEventId), which the Owner correctly flagged as an
// unproven assumption about Amazon's ID scheme. externalEventId is still
// stored and indexed for reconciliation and display, just not relied on
// as the uniqueness guarantee.
model SaleFinancialEvent {
  id                String             @id @default(cuid())
  saleId            String?
  saleItemId        String?
  productId         String?
  importBatchId     String?
  importedRowId     String?
  eventType         FinancialEventType
  amount            Decimal            @db.Decimal(12, 4)
  currency          String
  eventDate         DateTime
  externalEventId   String?
  importFingerprint String?
  source            TransactionSource  @default(FILE_IMPORT)
  notes             String?
  createdAt         DateTime           @default(now())

  sale        Sale?        @relation(fields: [saleId], references: [id])
  saleItem    SaleItem?    @relation(fields: [saleItemId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id])
  importedRow ImportedRow? @relation(fields: [importedRowId], references: [id])

  @@unique([importFingerprint])
  @@index([saleId])
  @@index([saleItemId])
  @@index([productId])
  @@index([externalEventId])
  @@map("sale_financial_events")
}
