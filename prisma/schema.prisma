// ==========================================================================
// KAWKAB OS — Phase 0 schema (canonical data foundation only)
//
// Nothing below depends on Product, Supplier, or any Phase 1+ entity.
// See /docs/KAWKAB-OS-Phase0-Implementation-Plan.md for the approved design
// and /ARCHITECTURE.md for the standing conventions every later phase must
// follow (provenance, completeness, never-zero-for-missing).
//
// Revisions applied per Owner approval before this migration was written:
//   1. DataStatus split into three independent enums (VerificationStatus,
//      CompletenessStatus, MatchStatus) instead of one enum conflating
//      verification, completeness, and reconciliation-matching. A record
//      can legitimately be VERIFIED + COMPLETE + MATCHED at once — a single
//      enum couldn't express that.
//   2. AuditLog.oldValue / newValue changed from String to Json (maps to
//      Postgres jsonb) so structured objects — a corrected cost allocation,
//      an AI proposal, a reconciliation diff — are stored natively instead
//      of being flattened through JSON.stringify() into a plain string.
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// USERS, SESSIONS, ROLES
// --------------------------------------------------------------------------

enum UserRole {
  OWNER
  OPERATOR
  AI_AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions     Session[]
  auditLogs    AuditLog[]
  uploadedDocs Document[] @relation("DocumentUploadedBy")
  verifiedDocs Document[] @relation("DocumentVerifiedBy")

  @@map("users")
}

// Auth.js database-session strategy — real, revocable server-side sessions.
// Owner can force-expire a session by deleting its row; nothing here trusts
// a client-supplied header for identity.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// --------------------------------------------------------------------------
// AUDIT TRAIL
// --------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CORRECT
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  PERMISSION_DENIED
}

// entityType/entityId are deliberately informational, not a real FK — an
// audit log has to be able to point at ANY table in the system, and
// Postgres has no polymorphic foreign key. This is the one place that
// tradeoff is correct; everywhere else (Documents, below) uses a real
// dedicated FK per entity type instead.
//
// oldValue/newValue are Json (jsonb in Postgres), not String, so a
// structured object — an array of corrected batch allocations, a
// reconciliation diff, an AI proposal payload — is stored as real,
// queryable structure rather than a flattened, unparseable string.
// fieldChanged stays a short descriptive label ("email", "cogs_allocation")
// even when oldValue/newValue hold a compound object, since Phase 0 has no
// case yet that needs a multi-field diff array in a single row — that can
// be added later without breaking this shape if a real need appears.
model AuditLog {
  id           String            @id @default(cuid())
  userId       String? // null = SYSTEM
  action       AuditAction
  entityType   String
  entityId     String
  fieldChanged String?
  oldValue     Json?
  newValue     Json?
  source       TransactionSource @default(MANUAL)
  timestamp    DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

// --------------------------------------------------------------------------
// PROVENANCE — finalized now, applied to every Phase 1+ table that carries
// operational or financial data. Nothing in Phase 0 attaches this to a real
// row yet except AuditLog.source above.
// --------------------------------------------------------------------------

enum TransactionSource {
  MANUAL
  AI_EXTRACTED
  SP_API
  SYSTEM
  FILE_IMPORT
}

// --------------------------------------------------------------------------
// DATA STATUS — three independent dimensions, not one conflated enum.
//
// VerificationStatus: has a human confirmed this is correct?
// CompletenessStatus: is all required data present? (pairs with the
//   CompletenessAware<T> wrapper in lib/types.ts — see ARCHITECTURE.md)
// MatchStatus: does this record reconcile against another source? Not
//   meaningful for most Phase 0/1 rows — NOT_APPLICABLE is the default,
//   not UNMATCHED, so a row that was never a reconciliation candidate
//   doesn't read as "failed to match."
//
// A record can be VERIFIED + COMPLETE + MATCHED simultaneously, or any
// other combination — that's exactly why these are three fields, not one.
// --------------------------------------------------------------------------

enum VerificationStatus {
  NEEDS_REVIEW
  VERIFIED
  REJECTED
}

enum CompletenessStatus {
  COMPLETE
  INCOMPLETE
}

enum MatchStatus {
  NOT_APPLICABLE
  UNMATCHED
  MATCHED
}

// --------------------------------------------------------------------------
// DOCUMENTS
// --------------------------------------------------------------------------

enum DocumentType {
  INVOICE
  RECEIPT
  PACKING_SLIP
  SHIPPING_DOCUMENT
  CREDIT_MEMO
  SUPPLIER_EMAIL
  AMAZON_DOCUMENT
  BUSINESS_REGISTRATION
  EIN_LETTER
  RESALE_CERTIFICATE
  BRAND_APPROVAL_DOCUMENT
  TAX_DOCUMENT
  INSURANCE_DOCUMENT
  SUPPLIER_AGREEMENT
  OTHER
}

model Document {
  id                 String             @id @default(cuid())
  fileUrl            String
  storageKey         String             @unique
  originalFilename   String
  mimeType           String
  sizeBytes          Int
  type               DocumentType
  uploadedByUserId   String?
  uploadedAt         DateTime           @default(now())
  aiExtractedFields  Json?
  verificationStatus VerificationStatus @default(NEEDS_REVIEW)
  verifiedByUserId   String? // Phase 1A addition — closes a gap in the Phase 0
  verifiedAt         DateTime? // schema: the provenance convention (ARCHITECTURE.md
  // #3) calls for verifiedBy/verifiedAt on anything
  // needing human sign-off, which a Document always does.
  notes              String?

  uploadedBy          User?                    @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  verifiedBy          User?                    @relation("DocumentVerifiedBy", fields: [verifiedByUserId], references: [id])
  businessRecordLinks BusinessRecordDocument[]
  productLinks        ProductDocument[]
  purchaseLinks       PurchaseDocument[]
  boxLinks            BoxDocument[]
  shipmentLinks       ShipmentDocument[]
  brandLinks          BrandDocument[]
  researchLinks       ResearchDocument[]

  // Every entity that needs documents gets its own dedicated join table —
  // never a polymorphic table. ProductDocument and PurchaseDocument below
  // are Phase 1A's additions to the pattern Phase 0 established.

  @@map("documents")
}

// Business/legal paperwork — the one entity Phase 0 needs in order to prove
// Documents infrastructure end-to-end (upload, store, link, retrieve,
// audit) without waiting on Product or Supplier to exist.
model BusinessRecord {
  id                String    @id @default(cuid())
  name              String
  category          String // e.g. Business Registration, EIN, Insurance
  issueDate         DateTime?
  expirationDate    DateTime?
  documentNumber    String?
  status            String    @default("active") // never hard-deleted
  visibleToOperator Boolean   @default(false) // Owner-only by default
  notes             String?
  createdAt         DateTime  @default(now())

  documents BusinessRecordDocument[]

  @@map("business_records")
}

model BusinessRecordDocument {
  id               String       @id @default(cuid())
  documentId       String
  businessRecordId String
  role             DocumentType

  document       Document       @relation(fields: [documentId], references: [id])
  businessRecord BusinessRecord @relation(fields: [businessRecordId], references: [id])

  @@index([businessRecordId])
  @@map("business_record_documents")
}

model ProductDocument {
  id         String       @id @default(cuid())
  documentId String
  productId  String
  role       DocumentType

  document Document @relation(fields: [documentId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_documents")
}

model PurchaseDocument {
  id         String       @id @default(cuid())
  documentId String
  purchaseId String
  role       DocumentType

  document Document @relation(fields: [documentId], references: [id])
  purchase Purchase @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
  @@map("purchase_documents")
}

// --------------------------------------------------------------------------
// MARKETPLACE / IDENTITY MAPPING
// --------------------------------------------------------------------------

model Marketplace {
  id          String   @id @default(cuid())
  code        String   @unique // Amazon marketplace ID, e.g. ATVPDKIKX0DER
  displayName String // e.g. "Amazon.com (US)"
  countryCode String
  currency    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  productIdentifiers ProductIdentifier[]
  shipments          Shipment[]
  sales              Sale[]

  @@map("marketplaces")
}

enum IdentifierType {
  ASIN
  FNSKU
  UPC
  EAN
  GTIN
  MPN
  INTERNAL_SKU
}

// ProductIdentifier now ships as a real table, with a real FK to Product,
// exactly as deferred in Phase 0 pending Product's existence. Per Owner
// approval: no temporary soft-reference version was ever created.
model ProductIdentifier {
  id            String         @id @default(cuid())
  productId     String
  marketplaceId String?
  type          IdentifierType
  value         String
  // false = superseded (e.g. the ASIN changed, or a listing was merged).
  // History is preserved, never overwritten — this is what lets a Product
  // carry more than one ASIN over its lifetime instead of assuming an
  // identifier is permanent.
  isCurrent     Boolean        @default(true)
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?

  product     Product      @relation(fields: [productId], references: [id])
  marketplace Marketplace? @relation(fields: [marketplaceId], references: [id])

  // "Only one isCurrent=true per (productId, type, marketplaceId)" is an
  // application-level invariant (enforced in lib/productIdentifiers.ts),
  // not a DB constraint — Postgres has no native partial-unique-where
  // support through Prisma's declarative schema. Same tradeoff class as
  // FIFO ordering being enforced in code rather than the database.
  @@index([productId])
  @@index([type, value])
  @@map("product_identifiers")
}

// --------------------------------------------------------------------------
// PRODUCTS
// --------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum FulfillmentType {
  UNKNOWN
  FBA
  FBM
}

model Product {
  id              String          @id @default(cuid())
  name            String
  // Free text, deliberately not a FK to a Brand table yet — per Owner
  // instruction, brand must always support manual entry; a Brand entity
  // with autocomplete can be layered on later without this field changing
  // shape (it would become the default/seed value for a new Brand row,
  // not get migrated away).
  brand           String?
  brandId         String? // optional formal link to a Brand CRM record — the free-text field above always still works
  status          ProductStatus   @default(ACTIVE)
  fulfillmentType FulfillmentType @default(UNKNOWN)
  notes           String?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  identifiers         ProductIdentifier[]
  purchaseItems       PurchaseItem[]
  documents           ProductDocument[]
  eligibility         ProductEligibility?
  consumptionEvents   ConsumptionEvent[]
  shipmentItems       ShipmentItem[]
  brandRef            Brand?               @relation(fields: [brandId], references: [id])
  researchEntries     ResearchEntry[]
  saleItems           SaleItem[]
  saleFinancialEvents SaleFinancialEvent[]
  matchedImportRows   ImportedRow[]

  @@map("products")
}

// 1:1 with Product. Kept as its own table rather than fields bolted onto
// Product — eligibility/approval-path data has its own lifecycle (it
// changes independently of the product's core identity) and this keeps
// Product from becoming a catch-all as more phases add to it.
model ProductEligibility {
  id                  String            @id @default(cuid())
  productId           String            @unique
  status              EligibilityStatus @default(UNKNOWN)
  approvalStatus      ApprovalStatus    @default(NOT_APPLICABLE)
  approvalNotes       String?
  potentialSupplierId String?
  invoicePathNotes    String?
  targetBuyPrice      Decimal?          @db.Decimal(12, 4)
  ownerNotes          String?
  updatedAt           DateTime          @updatedAt

  product           Product   @relation(fields: [productId], references: [id])
  potentialSupplier Supplier? @relation(fields: [potentialSupplierId], references: [id])

  @@map("product_eligibility")
}

enum EligibilityStatus {
  UNKNOWN
  OPEN
  RESTRICTED
  WORTH_UNLOCKING
}

enum ApprovalStatus {
  NOT_APPLICABLE
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  DENIED
}

// --------------------------------------------------------------------------
// SUPPLIERS (minimal — enough for Purchases to reference; a full Supplier
// module with scorecards/lead-time tracking is later phase scope)
// --------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  website   String? // optional — validated as a URL shape in the service layer, never required
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases            Purchase[]
  eligibilityCandidate ProductEligibility[]
  boxTypes             BoxType[]
  brands               Brand[]
  researchEntries      ResearchEntry[]

  @@map("suppliers")
}

// --------------------------------------------------------------------------
// PURCHASES
//
// Purchase = one invoice-level buying event (what the Owner's spec called
// a "batch": "Batch 001: 20 units, invoice total $240"). PurchaseItem =
// one product line within that purchase. A Purchase never gets overwritten
// by a later Purchase at a different price — each is its own permanent
// row, which is exactly the shape Phase 1B's FIFO consumption will need:
// PurchaseItem is the direct precursor to a future InventoryBatch (same
// one-row-per-purchase-per-product shape; FIFO-consumption fields get
// added to it later without restructuring what's here).
// --------------------------------------------------------------------------

model Purchase {
  id            String   @id @default(cuid())
  supplierId    String
  purchaseDate  DateTime
  // Required per Owner correction: a Purchase must always reference an
  // invoice or order number, even before any document is uploaded for it.
  // This is deliberately distinct from whether a document is attached —
  // see PurchaseDocument below and completenessStatus's derivation in
  // lib/purchases.ts, which now requires both cost fields AND at least
  // one linked document to reach COMPLETE, not just costs.
  invoiceNumber String

  // Shared, invoice-level costs. Every one of these is nullable, and
  // nullable is load-bearing: null means "not yet entered / unknown," a
  // real Decimal (including 0) means "confirmed, even if zero." This is
  // the schema-level implementation of "missing is never silently zero" —
  // see computeLandedCost() in lib/landedCost.ts, which refuses to
  // compute a final landed cost while any of these is null.
  invoiceTotal     Decimal  @db.Decimal(12, 4)
  tax              Decimal? @db.Decimal(12, 4)
  discount         Decimal? @db.Decimal(12, 4)
  supplierShipping Decimal? @db.Decimal(12, 4)
  localShipping    Decimal? @db.Decimal(12, 4)
  prepCost         Decimal? @db.Decimal(12, 4)
  packagingCost    Decimal? @db.Decimal(12, 4)
  otherCost        Decimal? @db.Decimal(12, 4)

  notes              String?
  source             TransactionSource  @default(MANUAL)
  verificationStatus VerificationStatus @default(NEEDS_REVIEW)
  // Stored, not only computed on read — recomputed and re-persisted every
  // time cost fields change (see lib/purchases.ts), so it can be filtered
  // and counted cheaply (e.g. the dashboard's "purchases needing review").
  // The stored value and a fresh computation must always agree; storing
  // it is a query-performance choice, not a second source of truth.
  completenessStatus CompletenessStatus @default(INCOMPLETE)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier  Supplier           @relation(fields: [supplierId], references: [id])
  items     PurchaseItem[]
  documents PurchaseDocument[]

  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id           String  @id @default(cuid())
  purchaseId   String
  productId    String
  quantity     Int
  // The portion of the invoice attributable to this line, before shared
  // costs (shipping/prep/packaging/tax/discount) are allocated across all
  // lines on the purchase. Always required — this is the one cost KAWKAB
  // can't proceed without at all, unlike the shared costs above which can
  // legitimately be entered later.
  lineItemCost Decimal @db.Decimal(12, 4)

  createdAt DateTime @default(now())

  purchase          Purchase           @relation(fields: [purchaseId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  // Phase 1B: this PurchaseItem is the FIFO "batch" — exactly the shape
  // Phase 1A's comments said it would become, with no restructuring
  // needed. Available quantity is never a stored counter on this row; it
  // is always SUM(quantity) over batchConsumptions, computed on read (see
  // lib/inventory.ts) — a stored running total would be a second source
  // of truth that could drift, which is exactly the class of bug the
  // Phase 0 codebase review flagged in the old prototype's correction
  // read-path.
  batchConsumptions BatchConsumption[]

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// --------------------------------------------------------------------------
// PHASE 1B: FIFO CONSUMPTION & HISTORICAL COGS LOCKING
//
// ConsumptionEvent is the "why" something left inventory. Phase 1B has no
// Amazon Orders yet (SP-API is Phase 4), so MANUAL_SALE / MANUAL_ADJUSTMENT
// are the only sources today — a wholesale sale, a sample sent out, damage,
// loss, personal use. AMAZON_ORDER is reserved, not added yet, so this
// enum doesn't need to change shape when Phase 4 arrives; it needs a new
// value added to it, which is additive.
//
// BatchConsumption is where FIFO actually happens: given a quantity to
// consume, oldest available PurchaseItem batches are drawn from first,
// and the unit cost is frozen at that moment — never recomputed later,
// even if the originating Purchase's cost fields are corrected afterward.
// That is historical COGS locking, enforced by construction, not by rule.
//
// A correction to a ConsumptionEvent is NEVER an edit to existing
// BatchConsumption rows. It is a new BatchConsumption row with a NEGATIVE
// quantity, at the same unitCost as what it's reversing, linked to a
// REVERSAL-type event. This is a deliberate change from the pattern the
// old prototype used (leave the original row untouched, add a new one,
// and hope every future read remembers to filter out the superseded
// row) — that exact pattern was the cause of a real double-counting bug
// found during the Phase 0 codebase review. Signed quantities net
// correctly under plain SUM() by construction; a superseded-row filter is
// only correct if every single read path remembers to apply it, which is
// precisely what failed before.
// --------------------------------------------------------------------------

enum ConsumptionEventType {
  MANUAL_SALE
  MANUAL_ADJUSTMENT
  SHIPMENT
  AMAZON_SALE
  REVERSAL
}

model ConsumptionEvent {
  id              String               @id @default(cuid())
  productId       String
  type            ConsumptionEventType
  quantity        Int
  eventDate       DateTime
  notes           String?
  source          TransactionSource    @default(MANUAL)
  reversesEventId String? // set only on a REVERSAL event, points at what it reverses
  shipmentId      String? // set only on a SHIPMENT event — the shipment that consumed this inventory
  saleItemId      String?              @unique // set only on an AMAZON_SALE event — the sale item that consumed this inventory
  createdByUserId String?
  createdAt       DateTime             @default(now())

  product          Product            @relation(fields: [productId], references: [id])
  reversesEvent    ConsumptionEvent?  @relation("EventReversal", fields: [reversesEventId], references: [id])
  reversedByEvents ConsumptionEvent[] @relation("EventReversal")
  shipment         Shipment?          @relation(fields: [shipmentId], references: [id])
  saleItem         SaleItem?          @relation(fields: [saleItemId], references: [id])
  consumptions     BatchConsumption[]

  @@index([productId])
  @@map("consumption_events")
}

model BatchConsumption {
  id                     String             @id @default(cuid())
  purchaseItemId         String
  consumptionEventId     String
  // Positive for a normal consumption, negative for a reversal — see the
  // module comment above for why signed quantities replace the old
  // "leave the original row, hope reads filter it" pattern.
  quantity               Int
  // Always known and frozen at consumption time — lineItemCost / quantity
  // from the batch being drawn from, independent of whether the fuller
  // landed cost was complete yet.
  unitPurchaseCost       Decimal            @db.Decimal(12, 4)
  // Null if the landed cost was INCOMPLETE at the moment of consumption —
  // frozen either way. If the Purchase's costs are completed later, this
  // does NOT retroactively update; see the Phase 1B build report for this
  // as a named, deliberate limitation.
  landedUnitCost         Decimal?           @db.Decimal(12, 4)
  costCompletenessStatus CompletenessStatus
  createdAt              DateTime           @default(now())

  purchaseItem     PurchaseItem     @relation(fields: [purchaseItemId], references: [id])
  consumptionEvent ConsumptionEvent @relation(fields: [consumptionEventId], references: [id])

  @@index([purchaseItemId])
  @@index([consumptionEventId])
  @@map("batch_consumptions")
}

// --------------------------------------------------------------------------
// PHASE 2: BOXES / PACKAGING
//
// A box type is a catalog entry for a kind of packaging material — not a
// Product (Products are sellable, ASIN-bearing Amazon items; boxes are an
// internal operational supply). Reusing the FULL Purchase/PurchaseItem/
// ConsumptionEvent/BatchConsumption stack for a supporting inventory this
// much simpler would itself be the kind of unnecessary duplication the
// architecture warns against, so BoxMovement is a single signed-quantity
// ledger instead: the same "signed rows net correctly under SUM(), by
// construction" principle Phase 1B established for FIFO reversals,
// applied to a leaner shape appropriate for packaging supplies. A
// PURCHASE movement records a positive quantity with the unit cost paid;
// a SHIPMENT_USE or MANUAL_ADJUSTMENT movement records a negative
// quantity; a REVERSAL movement negates a prior one — never edits it.
// On-hand quantity is always SUM(quantity), never a stored counter.
// --------------------------------------------------------------------------

model BoxType {
  id                String        @id @default(cuid())
  name              String
  lengthCm          Decimal?      @db.Decimal(8, 2)
  widthCm           Decimal?      @db.Decimal(8, 2)
  heightCm          Decimal?      @db.Decimal(8, 2)
  weightCapacityKg  Decimal?      @db.Decimal(8, 2)
  supplierId        String?
  lowStockThreshold Int?
  notes             String?
  status            ProductStatus @default(ACTIVE)
  createdByUserId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  movements     BoxMovement[]
  documents     BoxDocument[]
  shipmentBoxes ShipmentBox[]

  @@map("box_types")
}

enum BoxMovementType {
  PURCHASE
  SHIPMENT_USE
  MANUAL_ADJUSTMENT
  REVERSAL
}

model BoxMovement {
  id                 String            @id @default(cuid())
  boxTypeId          String
  type               BoxMovementType
  // Signed: positive = added to stock (a PURCHASE), negative = removed
  // (SHIPMENT_USE / MANUAL_ADJUSTMENT), and a REVERSAL carries the exact
  // negation of the movement it reverses.
  quantity           Int
  // Known and required for a PURCHASE movement (null = INCOMPLETE cost
  // data — never defaulted to zero); not applicable to a consumption
  // movement, since that cost was already locked in when the stock was
  // purchased, not when it's used.
  unitCost           Decimal?          @db.Decimal(12, 4)
  invoiceNumber      String? // set on PURCHASE movements, mirrors Purchase.invoiceNumber
  shipmentId         String? // set on SHIPMENT_USE movements
  notes              String?
  reversesMovementId String?
  source             TransactionSource @default(MANUAL)
  createdByUserId    String?
  createdAt          DateTime          @default(now())

  boxType  BoxType   @relation(fields: [boxTypeId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  reversesMovement    BoxMovement?  @relation("BoxMovementReversal", fields: [reversesMovementId], references: [id])
  reversedByMovements BoxMovement[] @relation("BoxMovementReversal")
  documents           BoxDocument[]

  @@index([boxTypeId])
  @@map("box_movements")
}

model BoxDocument {
  id            String       @id @default(cuid())
  documentId    String
  boxMovementId String
  role          DocumentType

  document    Document    @relation(fields: [documentId], references: [id])
  boxMovement BoxMovement @relation(fields: [boxMovementId], references: [id])
  boxType     BoxType?    @relation(fields: [boxTypeId], references: [id])
  boxTypeId   String?

  @@index([boxMovementId])
  @@map("box_documents")
}

// --------------------------------------------------------------------------
// PHASE 2: SHIPMENTS
//
// Creating a Shipment with items and boxes consumes real inventory
// immediately, in the same transaction — a ShipmentItem calls into the
// existing FIFO engine (recordConsumptionEvent, ConsumptionEventType.SHIPMENT)
// exactly the way a manual sale does, and a ShipmentBox writes a
// SHIPMENT_USE BoxMovement. This is deliberate reuse, not a parallel
// inventory system: Shipments is the fourth caller of the same FIFO
// machinery Phase 1B built (manual sale, manual adjustment, and now
// shipment), and cancelling a Shipment reverses those same events through
// the existing signed-reversal mechanism rather than a new one.
//
// destinationType/marketplaceId/source are shaped so a future Amazon FBA
// inbound-shipment sync can populate/update this model without a
// redesign — source becomes SP_API on synced rows, marketplaceId gets
// set from real Amazon data, and nothing here needs to change shape.
// --------------------------------------------------------------------------

enum ShipmentStatus {
  DRAFT
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ShipmentDestinationType {
  AMAZON_FBA
  CUSTOMER_DIRECT
  THIRD_PARTY_WAREHOUSE
  OTHER
}

model Shipment {
  id                 String                  @id @default(cuid())
  reference          String // internal shipment identifier — required, mirrors Purchase.invoiceNumber's role
  status             ShipmentStatus          @default(DRAFT)
  destinationType    ShipmentDestinationType @default(OTHER)
  destinationName    String? // free text until Amazon sync can provide a real FC code
  marketplaceId      String? // reserved for Amazon-sourced marketplace once SP-API exists
  carrier            String?
  trackingNumber     String?
  shipDate           DateTime?
  deliveredDate      DateTime?
  shippingCost       Decimal?                @db.Decimal(12, 4) // null = unknown, never defaulted to 0
  prepCost           Decimal?                @db.Decimal(12, 4)
  notes              String?
  source             TransactionSource       @default(MANUAL) // becomes SP_API for future Amazon-synced shipments
  completenessStatus CompletenessStatus      @default(INCOMPLETE)
  createdByUserId    String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  marketplace       Marketplace?       @relation(fields: [marketplaceId], references: [id])
  boxes             ShipmentBox[]
  items             ShipmentItem[]
  documents         ShipmentDocument[]
  boxMovements      BoxMovement[]
  consumptionEvents ConsumptionEvent[]

  @@map("shipments")
}

model ShipmentBox {
  id         String   @id @default(cuid())
  shipmentId String
  boxTypeId  String
  quantity   Int
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])
  boxType  BoxType  @relation(fields: [boxTypeId], references: [id])

  @@index([shipmentId])
  @@map("shipment_boxes")
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  productId  String
  quantity   Int
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([shipmentId])
  @@index([productId])
  @@map("shipment_items")
}

model ShipmentDocument {
  id         String       @id @default(cuid())
  documentId String
  shipmentId String
  role       DocumentType

  document Document @relation(fields: [documentId], references: [id])
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@map("shipment_documents")
}

// --------------------------------------------------------------------------
// PHASE 2: BRAND CRM
//
// Product.brand (free text) stays exactly as it was — manual entry always
// works, per the Phase 1A rule. Brand is the formal relationship record;
// Product.brandId is the optional link between them, anticipated in the
// original Phase 1A schema comment on Product.brand ("a Brand entity...
// can be layered on later without this field changing shape"). A
// restricted PRODUCT's path back to eligibility is tracked on
// ProductEligibility (already exists, per-product, matching how Amazon
// restrictions actually work) — Brand CRM tracks the relationship and
// communication history that might unlock that path, not a duplicate
// eligibility status of its own.
// --------------------------------------------------------------------------

enum BrandRelationshipStatus {
  NOT_CONTACTED
  IN_CONTACT
  NEGOTIATING
  PARTNERED
  DECLINED
  INACTIVE
}

model Brand {
  id                 String                  @id @default(cuid())
  name               String
  website            String?
  supplierId         String?
  relationshipStatus BrandRelationshipStatus @default(NOT_CONTACTED)
  notes              String?
  createdByUserId    String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  supplier   Supplier?       @relation(fields: [supplierId], references: [id])
  contacts   BrandContact[]
  activities BrandActivity[]
  products   Product[]
  documents  BrandDocument[]

  @@map("brands")
}

model BrandContact {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  email     String?
  phone     String?
  title     String?
  notes     String?
  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@map("brand_contacts")
}

enum BrandActivityType {
  EMAIL
  CALL
  MEETING
  NOTE
}

model BrandActivity {
  id              String            @id @default(cuid())
  brandId         String
  type            BrandActivityType
  summary         String
  activityDate    DateTime
  followUpDate    DateTime?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@map("brand_activities")
}

model BrandDocument {
  id         String       @id @default(cuid())
  documentId String
  brandId    String
  role       DocumentType

  document Document @relation(fields: [documentId], references: [id])
  brand    Brand    @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@map("brand_documents")
}

// --------------------------------------------------------------------------
// PHASE 2: RESEARCH
//
// Manual sourcing/opportunity records — not the AI Center, not live Amazon
// data. assumedCost/assumedSellingPrice are exactly that: assumptions the
// owner enters, never fabricated. Margin is computed on read from them
// when both are present, never stored, and never shown when either input
// is missing. A ResearchEntry can link to a real Product once it's
// actually sourced — the record's history doesn't reset when that happens.
// --------------------------------------------------------------------------

enum ResearchStatus {
  IDEA
  CHECKING
  VIABLE
  NOT_VIABLE
  SOURCING
  TESTING
  ADOPTED
  REJECTED
}

model ResearchEntry {
  id                  String         @id @default(cuid())
  title               String
  asin                String?
  sku                 String?
  productId           String?
  supplierId          String?
  assumedCost         Decimal?       @db.Decimal(12, 4)
  assumedSellingPrice Decimal?       @db.Decimal(12, 4)
  competitionNotes    String?
  restrictionNotes    String?
  status              ResearchStatus @default(IDEA)
  sourceUrl           String?
  notes               String?
  createdByUserId     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  product   Product?           @relation(fields: [productId], references: [id])
  supplier  Supplier?          @relation(fields: [supplierId], references: [id])
  documents ResearchDocument[]

  @@map("research_entries")
}

model ResearchDocument {
  id              String       @id @default(cuid())
  documentId      String
  researchEntryId String
  role            DocumentType

  document      Document      @relation(fields: [documentId], references: [id])
  researchEntry ResearchEntry @relation(fields: [researchEntryId], references: [id])

  @@index([researchEntryId])
  @@map("research_documents")
}

// --------------------------------------------------------------------------
// PHASE 2: SETTINGS — business-level configuration
//
// A real singleton row (application code enforces "only one exists"),
// not fabricated Amazon connection data. Integration readiness is read
// directly from whether real SP-API env vars are configured — see
// lib/settings.ts — never a UI toggle that could imply a connection
// exists when it doesn't.
// --------------------------------------------------------------------------

model BusinessSettings {
  id              String   @id @default(cuid())
  businessName    String?
  defaultCurrency String   @default("USD")
  timezone        String   @default("UTC")
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  @@map("business_settings")
}

