# Copy to .env and fill in real values before running Prisma or the app.

# Local Postgres example — adjust user/password/db name to your setup.
DATABASE_URL="postgresql://kawkab:kawkab@localhost:5432/kawkab_os?schema=public"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Storage — "local" for development, "s3" for production.
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage/documents"

# Required only when STORAGE_PROVIDER=s3
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
